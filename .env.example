# Copy to .env for local development. Never commit the real .env file.
POSTGRES_DB=court_protocol
POSTGRES_USER=court_app
# Use a long, unique password; this placeholder is for local development only.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# For running the API directly on the host. Docker Compose overrides this with host "postgres".
DATABASE_URL=postgresql://court_app:replace-with-a-long-random-password@localhost:5432/court_protocol?schema=public

# API
PORT=3000
# Replace with a long random value. The current starter uses a shared API key,
# which is suitable only for isolated local testing, not production user authentication.
API_KEY=replace-with-a-long-random-api-key
CORS_ORIGIN=http://localhost:5173
MAX_AUDIO_BYTES=1073741824

# Private storage. Keep outside any web public/ directory.
COURT_STORAGE_ROOT=/srv/court-protocol-storage

# Local offline ASR service
ASR_MODEL_PATH=/models/large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_SERVICE_URL=http://localhost:8000
ASR_SERVICE_API_KEY=replace-with-a-different-long-random-api-key
ASR_ALLOW_NETWORK=false
