# Local-only development defaults. Change all credentials before deployment.
P# Local-only development defaults. Change all credentials before deployment.
 POSTGRES_DB=court_protocol
 POSTGRES_USER=postgres
 POSTGRES_PASSWORD=123
DATABASE_URL=postgresql://postgres:123@localhost:5432/court_protocol?schema=public

# App
PORT=3000
API_KEY=change-me
CORS_ORIGIN=http://localhost:3000

# Private storage root — never map it to Next.js public/.
COURT_STORAGE_ROOT=/srv/court-protocol-storage
ASR_MODEL_PATH=/models/large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_SERVICE_URL=http://localhost:8000
ASR_SERVICE_API_KEY=change-me
ASR_ALLOW_NETWORK=false
